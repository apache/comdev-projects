<rdf:RDF xml:lang="en"
         xmlns="http://usefulinc.com/ns/doap#" 
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" 
         xmlns:asfext="http://projects.apache.org/ns/asfext#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/">
  <asfext:pmc rdf:about="fluss">
    <asfext:name>Apache Fluss</asfext:name>
    <asfext:charter>
    The mission of Apache Fluss is the creation and maintenance of software
    related to a streaming storage built for real-time analytics which can serve as the real-time data layer for Lakehouse architectures
    </asfext:charter>
    <foaf:homepage rdf:resource="https://fluss.apache.org"/>
  </asfext:pmc>
</rdf:RDF>
