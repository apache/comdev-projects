  <Project rdf:about="http://pivot.apache.org">
    <created>2012-03-26</created>
    <license rdf:resource="http://usefulinc.com/doap/licenses/asl20" />
    <name>Apache Pivot</name>
    <homepage rdf:resource="http://pivot.apache.org" />
    <asfext:pmc rdf:resource="http://attic.apache.org/" />
    <shortdesc>Apache Pivot is an open-source platform for building installable Internet applications (IIAs).</shortdesc>
    <description>Apache Pivot is an open-source platform for building installable Internet applications (IIAs).
It combines the enhanced productivity and usability features of a modern user interface toolkit with the robustness of the Java platform.
</description>
    <bug-database rdf:resource="http://issues.apache.org/jira/browse/PIVOT" />
    <mailing-list rdf:resource="http://pivot.apache.org/lists.html" />
    <download-page rdf:resource="http://pivot.apache.org/download.cgi" />
    <programming-language>Java</programming-language>
    <category rdf:resource="http://projects.apache.org/category/retired" />
    <category rdf:resource="http://projects.apache.org/category/library" />
    <release>
      <Version>
        <name>Bug fix and Compatible Improvements over Pivot-2.0</name>
        <created>2012-01-16</created>
        <revision>2.0.1</revision>
      </Version>
    </release>
    <repository>
      <SVNRepository>
        <location rdf:resource="http://svn.apache.org/repos/asf/pivot/trunk/"/>
        <browse rdf:resource="http://svn.apache.org/viewvc/pivot/"/>
      </SVNRepository>
    </repository>
    <maintainer>
      <foaf:Person>
        <foaf:name>Sandro Martini</foaf:name>
          <foaf:mbox rdf:resource="mailto:smartini@apache.org"/>
      </foaf:Person>
    </maintainer>
  </Project>
</rdf:RDF>
